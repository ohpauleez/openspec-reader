{
  "name": "openspec-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Firefox reader for local Markdown, OpenSpec, Alloy, Java, and OpenJML sources",
  "license": "MIT",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "lint:extension": "web-ext lint --source-dir dist",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest",
    "start": "web-ext run --source-dir dist --start-url about:blank",
    "test:browser": "tsx tests/browser.ts && tsx tests/presentation.ts && tsx tests/alloy-browser.ts && tsx tests/java-browser.ts && tsx tests/java-formatting-browser.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.1",
    "dompurify": "^3.2.6",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.1.1",
    "playwright": "1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
